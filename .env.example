# Copier ce fichier en ".env" puis adapter.

# Adresse IP et/ou nom de la machine qui heberge Nautilyou sur le reseau local, separes par des virgules.
# Ils sont inscrits dans le certificat auto-signe (genere une seule fois, au premier demarrage).
SERVER_NAME=192.168.1.50

# Ports exposes sur la machine (443/80 par defaut ; changer si deja utilises).
HTTPS_PORT=443
HTTP_PORT=80
